{
  "manifest_version": 3,
  "name": "Hyland Integrations Agent",
  "version": "0.2.0",
  "description": "Context-aware Hyland UCEB assistant: reads the business object on the current page and shows its related content. OAuth (Auth Code + PKCE) sign-in.",
  "icons": {
    "16": "src/assets/hyland-logo.png",
    "32": "src/assets/hyland-logo.png",
    "48": "src/assets/hyland-logo.png",
    "128": "src/assets/hyland-logo.png"
  },
  "action": {
    "default_title": "Hyland Integrations Agent",
    "default_icon": {
      "16": "src/assets/hyland-logo.png",
      "32": "src/assets/hyland-logo.png",
      "48": "src/assets/hyland-logo.png",
      "128": "src/assets/hyland-logo.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "permissions": [
    "identity",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://localhost:5010/*",
    "https://*.lightning.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.service-now.com/*",
    "https://*.workday.com/*",
    "https://*.myworkday.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.service-now.com/*",
        "https://*.workday.com/*",
        "https://*.myworkday.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["src/content/detector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uceb-agent-chatbot@hyland.local",
      "strict_min_version": "115.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/lib/pdf.worker.min.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
