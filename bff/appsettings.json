{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "AuthorizeEndpoint": "https://auth.dev.app.hyland.com/idp/connect/authorize",
    "TokenEndpoint": "https://auth.dev.app.hyland.com/idp/connect/token",
    "EndSessionEndpoint": "https://auth.dev.app.hyland.com/idp/connect/endsession",

    "ClientId": "wsc-5906caef-219c-4277-a4d8-2d86fb2fc1a0",
    // ClientSecret is NOT stored here. Set it with:
    //   dotnet user-secrets set "Auth:ClientSecret" "<the-secret>"
    "ClientSecret": "",

    "RedirectUri": "https://localhost:5010/auth/callback",
    "Scopes": "openid profile offline_access hxp environment_authorization"
  },

  "Agent": {
    "ApiBaseUrl": "https://api.agents.ai.dev.app.hyland.com",
    "AgentId": "a4374edc-32b0-4d01-bc45-8dbc496ed9c6",
    "VersionId": "latest",
  },

  "ContextAgent": {
    "ApiBaseUrl": "https://api.agents.ai.dev.app.hyland.com",
    "AgentId": "741a9eac-ed49-46e1-84ef-0e93e9c2239d",
    "VersionId": "latest"
  },

  "MappingAgent": {
    // solution_config_mapper_poc (Agent Builder Task agent) used by /api/autoconfig/agent-map.
    "ApiBaseUrl": "https://api.agents.ai.dev.app.hyland.com",
    "AgentId": "028b4d65-e2e5-4f75-bb50-69c8fc80c006",
    "VersionId": "latest"
  },

  "DataCuration": {
    // KE Data Curation API (full document text / OCR). ClientId + ClientSecret live in user-secrets.
    "TokenEndpoint": "https://auth.staging.app.hyland.com/idp/connect/token",
    "Scope": "environment_authorization",
    "BaseUrl": "https://knowledge-enrichment.ai.staging.app.hyland.com/latest/api/data-curation",
    "JsonSchema": "FULL",
    "TimeoutSeconds": 300
  },

  "Mcp": {
    // Base URL of the MCP server (WITHOUT the trailing /mcp). Locally this is http://localhost:5200;
    // in deployment use the reachable MCP URL (e.g. the dev tunnel). The BFF POSTs attachment bytes
    // to {BaseUrl}/staging/upload so the MCP can upload them to UCEB.
    "BaseUrl": "http://localhost:5200",
    "HeaderName": "X-Api-Key"
    // ApiKey is NOT stored here. Set it with:
    //   dotnet user-secrets set "Mcp:ApiKey" "<the-same-key-as-McpApiKey:ApiKey-on-the-MCP>"
  },

  "Workday": {
    // Workday Cloud Platform Staffing API. Used by GET /api/worker/resolve to look up a worker's WID
    // by name or Employee ID (search matches both). Tenant hylandbow_wcpdev1 (WCP dev preview).
    "StaffingBaseUrl": "https://wcpdev-services1.wd101.myworkday.com/ccx/api/staffing/v7/hylandbow_wcpdev1",
    // OAuth token endpoint for the tenant's registered API Client for Integrations.
    "TokenUrl": "https://wcpdev-services1.wd101.myworkday.com/ccx/oauth2/hylandbow_wcpdev1/token"
    // Credentials are NOT stored here. Set them with:
    //   dotnet user-secrets set "Workday:ClientId" "<client-id>"
    //   dotnet user-secrets set "Workday:ClientSecret" "<client-secret>"
    //   dotnet user-secrets set "Workday:RefreshToken" "<refresh-token>"   (if using refresh_token grant)
    //   dotnet user-secrets set "Workday:Scope" "Staffing"                  (optional)
    // For quick testing you can instead send a raw bearer via the X-Workday-Token request header.
  },

  "Idp": {
    // Hyland IDP classification REST API. Used by /api/idp/classify for auto document-type detection.
    "BaseUrl": "https://api.idp.staging.app.hyland.com",
    // General Purpose zero-shot classification execution profile (inline class definitions).
    "ClassificationProfileId": "078abc02-212b-42fa-92fb-f42edd6bb42d",
    "ClassificationProfileVersion": "3.0"
    // PublicBaseUrl: a devtunnel pointing at THIS BFF so IDP's cloud can fetch staged files.
    // Set it at demo time (do NOT commit a tunnel URL):
    //   dotnet user-secrets set "Idp:PublicBaseUrl" "https://<your-tunnel>.devtunnels.ms"
    // TokenFile defaults to %TEMP%/idp_token.txt (produced by bff/idp-feature-test.ps1). Override via
    //   dotnet user-secrets set "Idp:TokenFile" "<path>"
  },

  "Viewer": {
    // CFS-brokered systems whose docs open in the CIC viewer's /#/cfs/ route. Keyed by the active
    // systemFriendlyName. Without an entry, /api/viewer falls back to the MCP's /#/documents/ route.
    "CfsSystems": {
      "onbase_cfs_prod": {
        "Host": "https://cic-viewer.app.hyland.com",
        "IntegrationId": "62ff4bf7-c587-40df-a721-98e7b37b5c8a",
        "EnvKey": "appintel-production-prod",
        "LogicalPartId": "1"
      },
      "onbase_hcm_stg": {
        "Host": "https://cic-viewer.staging.app.hyland.com",
        "IntegrationId": "532c245c-a412-4f1e-8878-3097588179e5",
        "EnvKey": "appintel-staging-prod",
        "LogicalPartId": "1"
      }
    }
  }
}

