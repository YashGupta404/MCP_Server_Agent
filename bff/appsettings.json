{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "AuthorizeEndpoint": "https://auth.dev.app.hyland.com/idp/connect/authorize",
    "TokenEndpoint": "https://auth.dev.app.hyland.com/idp/connect/token",
    "EndSessionEndpoint": "https://auth.dev.app.hyland.com/idp/connect/endsession",

    "ClientId": "wsc-5906caef-219c-4277-a4d8-2d86fb2fc1a0",
    // ClientSecret is NOT stored here. Set it with:
    //   dotnet user-secrets set "Auth:ClientSecret" "<the-secret>"
    "ClientSecret": "",

    "RedirectUri": "https://localhost:5010/auth/callback",
    "Scopes": "openid profile offline_access hxp environment_authorization"
  },

  "Agent": {
    "ApiBaseUrl": "https://api.agents.ai.dev.app.hyland.com",
    "AgentId": "a4374edc-32b0-4d01-bc45-8dbc496ed9c6",
    "VersionId": "latest",
  },

  "Mcp": {
    // Base URL of the MCP server (WITHOUT the trailing /mcp). Locally this is http://localhost:5200;
    // in deployment use the reachable MCP URL (e.g. the dev tunnel). The BFF POSTs attachment bytes
    // to {BaseUrl}/staging/upload so the MCP can upload them to UCEB.
    "BaseUrl": "http://localhost:5200",
    "HeaderName": "X-Api-Key"
    // ApiKey is NOT stored here. Set it with:
    //   dotnet user-secrets set "Mcp:ApiKey" "<the-same-key-as-McpApiKey:ApiKey-on-the-MCP>"
  },

  "Workday": {
    // Workday Cloud Platform Staffing API. Used by GET /api/worker/resolve to look up a worker's WID
    // by name or Employee ID (search matches both). Tenant hylandbow_wcpdev1 (WCP dev preview).
    "StaffingBaseUrl": "https://wcpdev-services1.wd101.myworkday.com/ccx/api/staffing/v7/hylandbow_wcpdev1",
    // OAuth token endpoint for the tenant's registered API Client for Integrations.
    "TokenUrl": "https://wcpdev-services1.wd101.myworkday.com/ccx/oauth2/hylandbow_wcpdev1/token"
    // Credentials are NOT stored here. Set them with:
    //   dotnet user-secrets set "Workday:ClientId" "<client-id>"
    //   dotnet user-secrets set "Workday:ClientSecret" "<client-secret>"
    //   dotnet user-secrets set "Workday:RefreshToken" "<refresh-token>"   (if using refresh_token grant)
    //   dotnet user-secrets set "Workday:Scope" "Staffing"                  (optional)
    // For quick testing you can instead send a raw bearer via the X-Workday-Token request header.
  },

  "OnBase": {
    // When the MCP's active ECM system friendlyName is NOT this value, the panel treats it as OnBase/CFS:
    // it lists via the keyword document-query (query_documents) instead of the CIC record-scoped
    // list_documents, and stamps the record id into the OnBase keyword field on upload.
    "CicFriendlyName": "CIC",
    // OnBase keyword field id (an ecmFieldName from the solution config's metadataFieldImportMappings)
    // used to store + filter the record id. account / "COM - Application" uses 232 (Entity Name).
    "DefaultKeywordFieldId": "232",
    "KeywordFieldByType": {
      "account": "232"
    }
  }
}
